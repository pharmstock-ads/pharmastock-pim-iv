@model PharmaStock.Web.ViewModels.ProdutoFormViewModel
@{
    ViewData["Title"] = "Novo produto";
}

<h1 class="h3 mb-3">Novo produto</h1>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<form asp-action="Criar" method="post" class="col-12 col-lg-6">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Codigo" class="form-label fw-semibold"></label>
        <input asp-for="Codigo" class="form-control" />
        <span asp-validation-for="Codigo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold"></label>
        <input asp-for="Nome" class="form-control" maxlength="100" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CodBarra" class="form-label fw-semibold"></label>
        <input asp-for="CodBarra" class="form-control" maxlength="25" />
        <span asp-validation-for="CodBarra" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="IdFornecedor" class="form-label fw-semibold"></label>
        <select asp-for="IdFornecedor" class="form-select"
                asp-items="@(new SelectList(Model.FornecedoresDisponiveis, "Id", "NomeEmpresa"))">
            <option value="">Sem fornecedor</option>
        </select>
        <span asp-validation-for="IdFornecedor" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
