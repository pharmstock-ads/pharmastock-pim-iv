@model PharmaStock.Web.ViewModels.EntradaFormViewModel
@{
    ViewData["Title"] = "Nova entrada";
}

<h1 class="h3 mb-3">Nova entrada</h1>
<p class="text-muted mb-3">Informe lote, validade, quantidade e preço. O estoque sobe após gravar.</p>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<form asp-action="Registrar" method="post" class="col-12 col-lg-6">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="ProdutoId" class="form-label fw-semibold"></label>
        <select asp-for="ProdutoId" class="form-select"
                asp-items="@(new SelectList(Model.ProdutosDisponiveis, "Id", "Nome"))">
            <option value="">Selecione...</option>
        </select>
        <span asp-validation-for="ProdutoId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NumeroLote" class="form-label fw-semibold"></label>
        <input asp-for="NumeroLote" class="form-control" autocomplete="off" />
        <span asp-validation-for="NumeroLote" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Validade" class="form-label fw-semibold"></label>
        <input asp-for="Validade" class="form-control" type="date" />
        <span asp-validation-for="Validade" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantidade" class="form-label fw-semibold"></label>
        <input asp-for="Quantidade" class="form-control" />
        <span asp-validation-for="Quantidade" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PrecoUnitario" class="form-label fw-semibold"></label>
        <div class="input-group">
            <span class="input-group-text">R$</span>
            <input asp-for="PrecoUnitario" class="form-control" />
        </div>
        <span asp-validation-for="PrecoUnitario" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Registrar</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
