@model IReadOnlyList<(int IdVenda, int IdFuncionario, DateTime DataVenda, decimal ValorTotal)>
@{
    ViewData["Title"] = "Vendas";
}

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @sucesso
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Vendas</h1>
    <a asp-action="Registrar" class="btn btn-primary">Nova venda</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Data</th>
                <th scope="col">Funcionário</th>
                <th scope="col">Valor total</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-muted">Nenhuma venda registrada.</td>
                </tr>
            }
            else
            {
                foreach (var v in Model)
                {
                    <tr>
                        <td>@v.IdVenda</td>
                        <td>@v.DataVenda.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>#@v.IdFuncionario</td>
                        <td>@v.ValorTotal.ToString("C")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
