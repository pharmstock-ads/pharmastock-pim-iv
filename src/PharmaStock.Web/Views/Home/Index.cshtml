@{
    ViewData["Title"] = "Início";
}

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @sucesso
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

<div class="py-4">
    <h1 class="h3 mb-2">Olá, @Context.Session.GetString("FuncionarioNome")</h1>
    <p class="text-muted mb-4">Escolha uma operação do estoque.</p>

    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-controller="Entradas" asp-action="Registrar">Nova entrada</a>
        <a class="btn btn-outline-primary" asp-controller="Vendas" asp-action="Registrar">Nova venda</a>
        <a class="btn btn-outline-secondary" asp-controller="Vendas" asp-action="Index">Vendas</a>
    </div>
</div>
