@{
    ViewData["Title"] = "Início";
    var nome = Context.Session.GetString("FuncionarioNome") ?? "funcionário";
}

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @sucesso
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

<div class="py-3">
    <h1 class="h3 mb-1">Olá, @nome</h1>
    <p class="text-muted mb-4">Escolha uma operação do estoque.</p>

    <div class="alert alert-light border mb-4" role="note">
        O seed inicia lotes com quantidade zero. Use <strong>Nova entrada</strong> antes de vender ou de ver alertas no aplicativo.
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5 card-title">Fornecedor</h2>
                    <p class="card-text text-muted flex-grow-1">
                        Lista e cadastra empresas fornecedoras.
                    </p>
                    <a class="btn btn-outline-primary mt-2" asp-controller="Fornecedores" asp-action="Index">Fornecedores</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5 card-title">Produto</h2>
                    <p class="card-text text-muted flex-grow-1">
                        Lista, detalhe e cadastro com fornecedor opcional.
                    </p>
                    <a class="btn btn-outline-primary mt-2" asp-controller="Produtos" asp-action="Index">Produtos</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5 card-title">Entrada</h2>
                    <p class="card-text text-muted flex-grow-1">
                        Registra lote, validade, quantidade e preço. O estoque sobe após gravar.
                    </p>
                    <a class="btn btn-primary mt-2" asp-controller="Entradas" asp-action="Registrar">Nova entrada</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5 card-title">Venda</h2>
                    <p class="card-text text-muted flex-grow-1">
                        Baixa estoque sem escolher lote na tela.
                    </p>
                    <a class="btn btn-outline-primary mt-2" asp-controller="Vendas" asp-action="Registrar">Nova venda</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5 card-title">Histórico</h2>
                    <p class="card-text text-muted flex-grow-1">
                        Consulta as vendas já registradas nesta sessão de trabalho.
                    </p>
                    <a class="btn btn-outline-secondary mt-2" asp-controller="Vendas" asp-action="Index">Vendas</a>
                </div>
            </div>
        </div>
    </div>
</div>
